# =====================================================================

# Alzikrayat - Apache Server Routing & URL Rewriting Rules

#

# Pattern: Front Controller Pattern Enforcer

# Architecture: Presentation / Server Routing Tier

#

# This file configures Apache URL rewriting for the public application

# directory. Requests that do not correspond to an existing file or

# directory are forwarded to public/index.php so the application's

# manual PHP Router can determine the appropriate controller action.

# =====================================================================

# Enable Apache's URL rewriting engine.

RewriteEngine On

# Define the application's base URI for the local XAMPP environment.

# This must match the public directory path under xampp/htdocs/.

RewriteBase /alzikrayat/public/

# Do not rewrite requests that already point to an existing physical file.

# This allows assets such as CSS, JavaScript, and image files to be served

# directly by Apache without passing through the PHP Front Controller.

RewriteCond %{REQUEST_FILENAME} !-f

# Do not rewrite requests that already point to an existing physical directory.

# This prevents Apache from routing real directories through index.php.

RewriteCond %{REQUEST_FILENAME} !-d

# Front Controller Routing Rule:

# Forward every remaining request to public/index.php.

#

# QSA (Query String Append):

# Preserves existing GET query-string parameters when Apache rewrites

# the request to index.php.

#

# L (Last):

# Stops further rewrite-rule processing after this rule is applied.

RewriteRule ^ index.php [QSA,L]
